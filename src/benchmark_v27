"""
============================================================
V27 SPY BENCHMARK
============================================================

Research / paper-trading analysis ONLY.

Compares:
    1. V27 LONG / FLAT strategy
    2. SPY buy-and-hold

V27:
    models/v27_best.zip

Holdout:
    2024-01-01 onward

IMPORTANT:
    2024+ was never used during V27 model selection.

V27 action space:
    0 = HOLD / FLAT
    1 = BUY / LONG

No training occurs in this file.
"""

from pathlib import Path

import numpy as np
import pandas as pd

from stable_baselines3 import PPO


# ============================================================
# CONFIG
# ============================================================

MODEL_PATH = Path(
    "models/v27_best.zip"
)

DATA_FILE = Path(
    "data/market_features_v14.csv"
)

TRAIN_START = "2015-01-01"
TRAIN_END = "2023-12-29"

TEST_START = "2024-01-01"

INITIAL_CAPITAL = 10_000.0

TRANSACTION_COST = 0.0005


# ============================================================
# FEATURES
# ============================================================

FORBIDDEN_FEATURE_WORDS = {
    "future",
    "target",
    "label",
    "reward",
}


def find_features(df):

    excluded = {
        "Date",
        "future_1d_return",
        "future_3d_return",
        "future_5d_return",
        "future_10d_return",
        "target",
        "trade_reward",
        "trade_label",
    }

    features = []

    for column in df.columns:

        if column in excluded:
            continue

        lower = column.lower()

        if any(
            word in lower
            for word in FORBIDDEN_FEATURE_WORDS
        ):
            continue

        if lower in {
            "date",
            "datetime",
            "timestamp",
        }:
            continue

        features.append(column)

    return features


# ============================================================
# METRICS
# ============================================================

def max_drawdown(equity_curve):

    equity_curve = np.asarray(
        equity_curve,
        dtype=float
    )

    peak = np.maximum.accumulate(
        equity_curve
    )

    drawdowns = (
        equity_curve / peak
    ) - 1.0

    return float(
        drawdowns.min()
    )


def sharpe_ratio(returns):

    returns = np.asarray(
        returns,
        dtype=float
    )

    if len(returns) < 2:
        return 0.0

    std = returns.std(
        ddof=1
    )

    if std <= 1e-12:
        return 0.0

    return float(
        np.sqrt(252.0)
        * returns.mean()
        / std
    )


def annualized_return(
    initial,
    final,
    days
):

    years = days / 365.25

    if years <= 0:
        return 0.0

    return (
        (final / initial)
        ** (1.0 / years)
        - 1.0
    )


# ============================================================
# LOAD DATA
# ============================================================

def load_data():

    df = pd.read_csv(
        DATA_FILE
    )

    if "Date" not in df.columns:

        raise ValueError(
            "Dataset must contain Date."
        )

    df["Date"] = pd.to_datetime(
        df["Date"]
    )

    df = (
        df
        .sort_values("Date")
        .reset_index(drop=True)
    )

    return df


# ============================================================
# PREPARE FEATURES
# ============================================================

def prepare_features(df):

    features = find_features(
        df
    )

    if len(features) != 85:

        raise ValueError(
            f"Expected 85 features, "
            f"found {len(features)}."
        )

    train = df[
        (df["Date"] >= pd.Timestamp(
            TRAIN_START
        ))
        &
        (df["Date"] <= pd.Timestamp(
            TRAIN_END
        ))
    ].copy()

    test = df[
        df["Date"] >= pd.Timestamp(
            TEST_START
        )
    ].copy()

    train = train.dropna(
        subset=features
    ).reset_index(
        drop=True
    )

    test = test.dropna(
        subset=features
    ).reset_index(
        drop=True
    )

    train_X = (
        train[features]
        .astype(np.float32)
        .to_numpy()
    )

    test_X = (
        test[features]
        .astype(np.float32)
        .to_numpy()
    )

    # --------------------------------------------------------
    # IMPORTANT:
    # Normalize ONLY using training-period statistics.
    # --------------------------------------------------------

    mean = np.nanmean(
        train_X,
        axis=0
    )

    std = np.nanstd(
        train_X,
        axis=0
    )

    std[
        std < 1e-8
    ] = 1.0

    test_X = (
        (test_X - mean)
        / std
    )

    test_X = np.nan_to_num(
        test_X,
        nan=0.0,
        posinf=0.0,
        neginf=0.0
    )

    test_X = np.clip(
        test_X,
        -10.0,
        10.0
    ).astype(np.float32)

    return (
        test,
        test_X,
        features
    )


# ============================================================
# V27 SIMULATION
# ============================================================

def run_v27(
    model,
    test,
    test_X
):

    equity = INITIAL_CAPITAL

    position = 0

    equity_curve = [
        equity
    ]

    daily_returns = []

    actions = []

    trade_count = 0

    long_days = 0

    wins = 0

    active_returns = []

    # --------------------------------------------------------
    # Future return is used ONLY after the model chooses.
    # --------------------------------------------------------

    if "future_1d_return" in test.columns:

        future_returns = (
            test[
                "future_1d_return"
            ]
            .astype(float)
            .to_numpy()
        )

    else:

        future_returns = (
            test[
                "SPY_return_1d"
            ]
            .shift(-1)
            .fillna(0.0)
            .astype(float)
            .to_numpy()
        )

    # --------------------------------------------------------
    # MODEL LOOP
    # --------------------------------------------------------

    for i in range(
        len(test_X) - 1
    ):

        observation = (
            test_X[i]
        )

        action, _ = model.predict(
            observation,
            deterministic=True
        )

        action = int(
            np.asarray(
                action
            ).item()
        )

        # ----------------------------------------------------
        # V27 ACTIONS
        #
        # 0 = HOLD / FLAT
        # 1 = BUY / LONG
        # ----------------------------------------------------

        if action not in (0, 1):

            raise RuntimeError(
                f"Unexpected V27 action: "
                f"{action}"
            )

        new_position = (
            1
            if action == 1
            else 0
        )

        changed = (
            new_position
            != position
        )

        cost = (
            TRANSACTION_COST
            if changed
            else 0.0
        )

        if changed:
            trade_count += 1

        market_return = (
            future_returns[i]
        )

        if new_position == 1:

            strategy_return = (
                market_return
            )

            long_days += 1

            active_returns.append(
                market_return
            )

            if market_return > 0:
                wins += 1

        else:

            strategy_return = 0.0

        strategy_return -= cost

        equity *= (
            1.0
            + strategy_return
        )

        daily_returns.append(
            strategy_return
        )

        equity_curve.append(
            equity
        )

        actions.append(
            action
        )

        position = (
            new_position
        )

    return {
        "final": equity,
        "equity_curve": equity_curve,
        "returns": daily_returns,
        "actions": actions,
        "trades": trade_count,
        "long_days": long_days,
        "wins": wins,
        "active_returns": active_returns,
    }


# ============================================================
# SPY BUY AND HOLD
# ============================================================

def run_spy(test):

    returns = (
        test[
            "SPY_return_1d"
        ]
        .astype(float)
        .to_numpy()
    )

    equity = INITIAL_CAPITAL

    equity_curve = [
        equity
    ]

    daily_returns = []

    for r in returns:

        equity *= (
            1.0 + r
        )

        daily_returns.append(
            r
        )

        equity_curve.append(
            equity
        )

    return {
        "final": equity,
        "equity_curve": equity_curve,
        "returns": daily_returns,
    }


# ============================================================
# YEARLY V27
# ============================================================

def yearly_v27(
    model,
    df
):

    features = find_features(
        df
    )

    train = df[
        (df["Date"] >= pd.Timestamp(
            TRAIN_START
        ))
        &
        (df["Date"] <= pd.Timestamp(
            TRAIN_END
        ))
    ].dropna(
        subset=features
    )

    train_X = (
        train[features]
        .astype(np.float32)
        .to_numpy()
    )

    mean = np.nanmean(
        train_X,
        axis=0
    )

    std = np.nanstd(
        train_X,
        axis=0
    )

    std[
        std < 1e-8
    ] = 1.0

    results = []

    years = sorted(
        df["Date"]
        .dt.year
        .unique()
    )

    for year in years:

        if year < 2024:
            continue

        yearly = df[
            df["Date"].dt.year == year
        ].copy()

        yearly = yearly.dropna(
            subset=features
        ).reset_index(
            drop=True
        )

        if len(yearly) < 2:
            continue

        year_X = (
            yearly[features]
            .astype(np.float32)
            .to_numpy()
        )

        year_X = (
            (year_X - mean)
            / std
        )

        year_X = np.nan_to_num(
            year_X,
            nan=0.0,
            posinf=0.0,
            neginf=0.0
        )

        year_X = np.clip(
            year_X,
            -10.0,
            10.0
        ).astype(np.float32)

        if "future_1d_return" in yearly.columns:

            future = (
                yearly[
                    "future_1d_return"
                ]
                .astype(float)
                .to_numpy()
            )

        else:

            future = (
                yearly[
                    "SPY_return_1d"
                ]
                .shift(-1)
                .fillna(0.0)
                .astype(float)
                .to_numpy()
            )

        equity = INITIAL_CAPITAL

        position = 0

        returns = []

        curve = [
            equity
        ]

        trades = 0

        long_days = 0

        wins = 0

        for i in range(
            len(year_X) - 1
        ):

            action, _ = model.predict(
                year_X[i],
                deterministic=True
            )

            action = int(
                np.asarray(
                    action
                ).item()
            )

            if action not in (0, 1):

                raise RuntimeError(
                    f"Unexpected V27 action: "
                    f"{action}"
                )

            new_position = (
                1
                if action == 1
                else 0
            )

            changed = (
                new_position
                != position
            )

            cost = (
                TRANSACTION_COST
                if changed
                else 0.0
            )

            if changed:
                trades += 1

            r = future[i]

            if new_position == 1:

                strategy_return = r

                long_days += 1

                if r > 0:
                    wins += 1

            else:

                strategy_return = 0.0

            strategy_return -= cost

            equity *= (
                1.0
                + strategy_return
            )

            returns.append(
                strategy_return
            )

            curve.append(
                equity
            )

            position = (
                new_position
            )

        results.append({
            "year": int(year),

            "v27_return": (
                equity
                / INITIAL_CAPITAL
                - 1.0
            ),

            "v27_max_dd": max_drawdown(
                curve
            ),

            "v27_sharpe": sharpe_ratio(
                returns
            ),

            "trades": trades,

            "long_days": long_days,

            "win_rate": (
                wins / long_days
                if long_days > 0
                else 0.0
            ),
        })

    return pd.DataFrame(
        results
    )


# ============================================================
# MAIN
# ============================================================

def main():

    print()
    print("=" * 60)
    print("V27 vs SPY BENCHMARK")
    print("=" * 60)

    # --------------------------------------------------------
    # MODEL
    # --------------------------------------------------------

    if not MODEL_PATH.exists():

        raise FileNotFoundError(
            f"Missing model: "
            f"{MODEL_PATH}"
        )

    print()
    print(
        "[BENCHMARK] Loading V27..."
    )

    model = PPO.load(
        str(MODEL_PATH),
        device="cpu"
    )

    print(
        f"[BENCHMARK] Model action space: "
        f"{model.action_space}"
    )

    if model.action_space.n != 2:

        raise ValueError(
            "V27 benchmark expects "
            "Discrete(2)."
        )

    # --------------------------------------------------------
    # DATA
    # --------------------------------------------------------

    df = load_data()

    (
        test,
        test_X,
        features
    ) = prepare_features(df)

    print()
    print(
        f"Holdout: "
        f"{test['Date'].iloc[0].date()} "
        f"→ "
        f"{test['Date'].iloc[-1].date()}"
    )

    print(
        f"Holdout rows: "
        f"{len(test)}"
    )

    print(
        f"Features: "
        f"{len(features)}"
    )

    # --------------------------------------------------------
    # V27
    # --------------------------------------------------------

    print()
    print(
        "[BENCHMARK] Running V27..."
    )

    v27 = run_v27(
        model,
        test,
        test_X
    )

    # --------------------------------------------------------
    # SPY
    # --------------------------------------------------------

    print(
        "[BENCHMARK] Running SPY..."
    )

    spy = run_spy(
        test
    )

    # --------------------------------------------------------
    # METRICS
    # --------------------------------------------------------

    days = (
        test["Date"].iloc[-1]
        - test["Date"].iloc[0]
    ).days

    v27_return = (
        v27["final"]
        / INITIAL_CAPITAL
        - 1.0
    )

    spy_return = (
        spy["final"]
        / INITIAL_CAPITAL
        - 1.0
    )

    excess_return = (
        v27_return
        - spy_return
    )

    v27_annualized = annualized_return(
        INITIAL_CAPITAL,
        v27["final"],
        days
    )

    spy_annualized = annualized_return(
        INITIAL_CAPITAL,
        spy["final"],
        days
    )

    v27_dd = max_drawdown(
        v27["equity_curve"]
    )

    spy_dd = max_drawdown(
        spy["equity_curve"]
    )

    v27_sharpe = sharpe_ratio(
        v27["returns"]
    )

    spy_sharpe = sharpe_ratio(
        spy["returns"]
    )

    active_returns = (
        v27["active_returns"]
    )

    if active_returns:

        win_rate = (
            v27["wins"]
            / len(active_returns)
        )

        avg_active = np.mean(
            active_returns
        )

    else:

        win_rate = 0.0

        avg_active = 0.0

    total_days = len(
        v27["actions"]
    )

    time_in_market = (
        v27["long_days"]
        / total_days
        if total_days > 0
        else 0.0
    )

    # --------------------------------------------------------
    # RESULTS
    # --------------------------------------------------------

    print()
    print("=" * 60)
    print("OVERALL RESULTS")
    print("=" * 60)

    print()
    print(
        f"{'Metric':<25}"
        f"{'V27':>15}"
        f"{'SPY':>15}"
    )

    print("-" * 55)

    print(
        f"{'Final value':<25}"
        f"${v27['final']:>13,.2f}"
        f"${spy['final']:>13,.2f}"
    )

    print(
        f"{'Return':<25}"
        f"{v27_return * 100:>14.2f}%"
        f"{spy_return * 100:>14.2f}%"
    )

    print(
        f"{'Annualized':<25}"
        f"{v27_annualized * 100:>14.2f}%"
        f"{spy_annualized * 100:>14.2f}%"
    )

    print(
        f"{'Max drawdown':<25}"
        f"{v27_dd * 100:>14.2f}%"
        f"{spy_dd * 100:>14.2f}%"
    )

    print(
        f"{'Sharpe':<25}"
        f"{v27_sharpe:>15.3f}"
        f"{spy_sharpe:>15.3f}"
    )

    print()
    print(
        f"V27 excess return: "
        f"{excess_return * 100:+.2f}%"
    )

    print(
        f"V27 trades: "
        f"{v27['trades']}"
    )

    print(
        f"V27 time in market: "
        f"{time_in_market * 100:.2f}%"
    )

    print(
        f"V27 win rate: "
        f"{win_rate * 100:.2f}%"
    )

    print(
        f"V27 average active return: "
        f"{avg_active * 100:.4f}%"
    )

    # --------------------------------------------------------
    # YEARLY
    # --------------------------------------------------------

    yearly = yearly_v27(
        model,
        df
    )

    print()
    print("=" * 60)
    print("V27 BY YEAR")
    print("=" * 60)

    if len(yearly) > 0:

        print(
            yearly.to_string(
                index=False,
                formatters={
                    "v27_return":
                        lambda x:
                        f"{x * 100:.2f}%",

                    "v27_max_dd":
                        lambda x:
                        f"{x * 100:.2f}%",

                    "v27_sharpe":
                        lambda x:
                        f"{x:.3f}",

                    "win_rate":
                        lambda x:
                        f"{x * 100:.2f}%",
                }
            )
        )

    # --------------------------------------------------------
    # SAVE
    # --------------------------------------------------------

    output = Path(
        "data/v27_benchmark_yearly.csv"
    )

    yearly.to_csv(
        output,
        index=False
    )

    print()
    print(
        f"Saved yearly results: "
        f"{output}"
    )

    print()
    print("=" * 60)
    print("V27 BENCHMARK COMPLETE")
    print("=" * 60)


if __name__ == "__main__":

    main()
